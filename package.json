{
    "name": "iobroker.heiko",
    "version": "0.13.0",
    "description": "Run a W600 TCP bridge and confirmed direct control for Heiko/Sprsun/Neoheat heat pumps",
    "author": {
        "name": "Zorax24"
    },
    "contributors": [],
    "homepage": "https://github.com/Zorax24/ioBroker.heiko",
    "license": "MIT",
    "keywords": [
        "ioBroker",
        "heiko",
        "sprsun",
        "neoheat",
        "heat-pump",
        "w600",
        "tcp",
        "bridge"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/Zorax24/ioBroker.heiko.git"
    },
    "engines": {
        "node": ">= 20"
    },
    "dependencies": {
        "@iobroker/adapter-core": "^3.4.1"
    },
    "devDependencies": {
        "@iobroker/adapter-dev": "^1.5.0",
        "@iobroker/eslint-config": "^2.2.0",
        "@iobroker/testing": "^5.2.2",
        "@tsconfig/node20": "^20.1.9",
        "@types/iobroker": "npm:@iobroker/types@^7.1.0",
        "@types/mocha": "^10.0.10",
        "@types/node": "^24.0.0",
        "mocha": "^11.7.0",
        "rimraf": "^6.1.3",
        "source-map-support": "^0.5.21",
        "ts-node": "^10.9.2",
        "typescript": "~5.9.3"
    },
    "main": "build/main.js",
    "files": [
        "admin{,/!(src)/**}/!(tsconfig|tsconfig.*|.eslintrc).{json,json5}",
        "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
        "build/**/*.js",
        "io-package.json",
        "CHANGELOG.md",
        "MAPPING.md",
        "LICENSE",
        "README.md",
        "README.de.md",
        "docs/",
        "THIRD_PARTY_NOTICES.md"
    ],
    "scripts": {
        "prebuild": "rimraf build",
        "build": "build-adapter ts",
        "watch": "build-adapter ts --watch",
        "test:ts": "mocha --config test/mocharc.custom.json src/**/*.test.ts",
        "test:package": "mocha test/package --exit",
        "test:regressions": "mocha test/regressions.test.cjs --timeout 30000",
        "test:integration": "node scripts/run-offline-integration.cjs",
        "test": "npm run test:ts && npm run test:package",
        "check": "tsc --noEmit",
        "lint": "eslint -c eslint.config.mjs .",
        "translate": "translate-adapter"
    },
    "bugs": {
        "url": "https://github.com/Zorax24/ioBroker.heiko/issues"
    },
    "readmeFilename": "README.md"
}
